[Unit]
Description=StudyLoop Django community (waitress)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/studyloop
Environment="DJANGO_SETTINGS_MODULE=studyplan.settings"
Environment="DJANGO_DEBUG=0"
Environment="DJANGO_ALLOWED_HOSTS=8.137.166.186,127.0.0.1,localhost"
Environment="DJANGO_CSRF_TRUSTED_ORIGINS=http://8.137.166.186:8081"
Environment="STUDYLOOP_HOST=127.0.0.1"
Environment="STUDYLOOP_PORT=8011"
Environment="STUDYLOOP_THREADS=8"
ExecStart=/opt/studyloop/.venv/bin/python /opt/studyloop/deploy/waitress_server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/studyloop

[Install]
WantedBy=multi-user.target
